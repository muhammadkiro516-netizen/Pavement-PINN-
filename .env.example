# --- Production (docker compose, SPEC §6) ------------------------------------------
# Domain served by Caddy with automatic HTTPS.
# DOMAIN=lapor.contoh.id
# SESSION_SECRET=   (required in production, >= 32 chars)
# DEMO_AUTH=false

# Not used by the code (kept empty on purpose).
GEMINI_API_KEY=

# --- Optional (defaults shown) ---------------------------------------------------
# Note: the server does NOT load .env files by itself; export these in the shell
# (or your process manager) before running `npm run dev` / `npm start`.
#
# Port of the Express server.
# PORT=3000
#
# Base path the SPA is built for and served under. The default matches the GitHub
# Pages deployment of the original repo. The Pages workflow sets /<repository name>/
# automatically (https://farrelberwyn.github.io/Pavement-Pinn/). Use "/" for root hosting.
# Must be set identically for `vite build` and for the server.
# VITE_BASE_PATH=/PavementPinn/
#
# Never expose GEMINI_API_KEY through a VITE_* variable: Vite inlines VITE_* values
# into the public JavaScript bundle.

# --- Map basemap (optional) ------------------------------------------------------
# MapTiler browser key for the public globe map. VITE_ variables are embedded in the
# client bundle, so use a key meant for browsers and restrict it to your site origins in
# the MapTiler dashboard. Without it the map uses OpenFreeMap (keyless vector tiles).
# VITE_MAPTILER_KEY=

# --- Workflow server (report workflow, roles, audit) -------------------------------
# Directory of the local workflow store (atomic JSON snapshot). Development/demo
# persistence only; the cloud target is Supabase (supabase/migrations/, not connected).
# DATA_DIR=.data
#
# HMAC secret for server-signed session tokens, at least 32 characters. If unset, a
# key is generated once and kept in DATA_DIR/session-secret (gitignored), so sessions
# survive restarts. Production must set it explicitly.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# SESSION_SECRET=
#
# Demo account picker (sessions for the bundled demo accounts without credentials).
# Set to false wherever real authentication is required; anonymous citizen sessions
# stay available.
# DEMO_AUTH=true
#
# Sessions end 2 hours after login (absolute; refreshes never extend them). This may only
# SHORTEN the limit, for testing expiry outside production; it is ignored in production.
# SESSION_MAX_AGE_SECONDS=7200
#
# Python inference service (layered-elastic + Monte Carlo engine), server-side only.
# INFERENCE_URL=http://127.0.0.1:8100

# --- Planned cloud services (NOT used by the code yet) -----------------------------
# Supabase project for PostgreSQL/PostGIS, Auth and Storage. The schema is ready in
# supabase/migrations/; no adapter is wired until a project exists. Never expose the
# service-role key through a VITE_* variable.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=

