  "sod_rules": [
    {
      "id": "SOD-1",
      "name": "Executor != verifier",
      "check": "person(supervisor) != person(crew); for CONTRACT also org(supervisor) != org(crew)",
      "actions": [
        "ISSUE_WORK_ORDER",
        "VERIFY_WORK",
        "REJECT_WORK"
      ],
      "basis": "Perpres 16/2018 jo. 12/2021 Pasal 16(1)"
    },
    {
      "id": "SOD-2",
      "name": "Recommender != approver",
      "check": "person(approver) not in {plan.proposer, inspection.inspector}",
      "actions": [
        "APPROVE_PLAN",
        "ACCEPT_WORK"
      ],
      "basis": "shared decision"
    },
    {
      "id": "SOD-3",
      "name": "No provider-linked official",
      "check": "no conflict_declaration(person(actor), package.provider_org) and org(actor) != package.provider_org for FIELD_INSPECTOR, COORDINATOR, APPROVER, SUPERVISOR, AUDITOR, AGENCY_HEAD",
      "actions": [
        "*"
      ],
      "basis": "Perpres 46/2025 Pasal 7(2)"
    },
    {
      "id": "SOD-4",
      "name": "Crew != supervisor != post-repair verifier",
      "check": "person(follow_up.recorder) not in {crew, supervisor} for M3, HEAVY_RAIN, EVERY_6M",
      "actions": [
        "RECORD_FOLLOW_UP"
      ],
      "basis": "shared decision"
    },
    {
      "id": "SOD-5",
      "name": "Acceptance after independent verification",
      "check": "state == WORK_VERIFIED and work.verified event by SUPERVISOR exists",
      "actions": [
        "ACCEPT_WORK"
      ],
      "basis": "Perpres Pasal 11(1)(l), 57-58"
    },
    {
      "id": "SOD-6",
      "name": "Permitted overlaps logged",
      "check": "if sub_type in {KPA_AS_PPK, PPTK_AS_PPK} or multiple roles in same authority then event.overlap_basis required",
      "actions": [
        "*"
      ],
      "basis": "Perpres 12/2021 Pasal 10(5), 11(3)-(4)"
    },
    {
      "id": "SOD-7",
      "name": "Transfer needs SK; cross-level needs second person",
      "check": "payload.decree_ref required; if level changes then transfer_confirm by different person of target authority",
      "actions": [
        "TRANSFER_AUTHORITY"
      ],
      "basis": "PP 34/2006 Pasal 62"
    },
    {
      "id": "SOD-8",
      "name": "Auditors and admins never operate",
      "check": "role in {AUDITOR, ADMIN} rejected on transitions; AUDITOR cannot hold operational role in same authority",
      "actions": [
        "*"
      ],
      "basis": "APIP independence (TODO_VERIFY PP 60/2008)"
    },
    {
      "id": "SOD-9",
      "name": "Toll regulator flag-only",
      "check": "sub_type TOLL_REGULATOR may flag.create only",
      "actions": [
        "*"
      ],
      "basis": "KPK finding on BPJT-BUJT conflicts (IDX Channel, 9 Mar 2023)"
    },
    {
      "id": "SOD-10",
      "name": "Citizen dispute triggers verification",
      "check": ">=2 independent devices DAMAGED (or 1 with photo and trust_tier 1) within window -> inspector follow-up task",
      "actions": [
        "RECORD_FOLLOW_UP"
      ],
      "basis": "design (note 04 SoD-8)"
    },
    {
      "id": "SOD-11",
      "name": "No self-accept of staff-created reports",
      "check": "if case.created_by is staff then ACCEPT by different person",
      "actions": [
        "ACCEPT"
      ],
      "basis": "design"
    },
    {
      "id": "SOD-12",
      "name": "No self-granting",
      "check": "role_assignment.created_by != role_assignment.account_id; APPROVER needs appointment_ref",
      "actions": [
        "role_assignment.manage"
      ],
      "basis": "design"
    },
    {
      "id": "SOD-13",
      "name": "Delay-extension cap",
      "check": "4th consecutive SET_PENDING requires AGENCY_HEAD",
      "actions": [
        "SET_PENDING"
      ],
      "basis": "design"
    }
  ],
